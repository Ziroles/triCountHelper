# Address of the SplitTicket API.
#
# Defaults to "/api", which assumes the API is served from the same origin as
# the application — that is what the bundled nginx configuration does, and it
# avoids every CORS question.
#
# In development, `npm run dev` already proxies /api to http://localhost:8787
# (see `server.proxy` in vite.config.ts): nothing to set.
#
# VITE_API_URL=https://splitticket.example.com/api

# The instance's signup key, if the server requires one
# (SPLITTICKET_SIGNUP_KEY on the API side). It is only needed to enrol a new
# device.
#
# This value is baked into the shipped bundle and is therefore PUBLIC: it only
# closes an instance to passers-by, not to someone reading the source code.
# Never put a Gemini key or a password here.
#
# VITE_SIGNUP_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
#
# In development, the application's logs go to the terminal running
# `npm run dev`, not to the browser console. That is what makes it possible to
# follow a phone lying on the table, where no console can be opened.
#
# Threshold: debug | info | warn | error | silent.
# Default: "debug" in development, "warn" in production.
#
# VITE_LOG_LEVEL=debug

# Set to "1" to write *also* to the browser console, when you would rather have
# it in front of you in the tab. Default: no.
#
# VITE_LOG_ECHO=

# Set to "0" to stop forwarding the page's `console.*` calls to the terminal
# (React warnings, third-party libraries). Default: forwarded.
#
# VITE_LOG_CONSOLE=
