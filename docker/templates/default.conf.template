# Le nom de l'API est résolu à chaque requête, et non une seule fois au
# démarrage : nginx démarre donc même si l'API n'est pas encore levée, et il
# la retrouve quand Docker lui attribue une nouvelle adresse. Avec un nom
# écrit en dur dans `proxy_pass`, nginx refuse de démarrer — c'est
# l'erreur « host not found in upstream ».
resolver ${SPLITTICKET_RESOLVER} valid=10s ipv6=off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/manifest+json image/svg+xml;

    # The API on the same origin as the application: no CORS to configure, and
    # the device token never crosses an origin boundary.
    location /api/ {
        set $upstream_api ${SPLITTICKET_API};

        # `proxy_pass` avec une variable ne retire pas le préfixe de la
        # `location` : on le retire nous-mêmes, comme le faisait la barre
        # oblique finale de `proxy_pass http://…:8787/`.
        rewrite ^/api/(.*)$ /$1 break;

        proxy_pass http://$upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A receipt photo, and the time the model takes to read it.
        client_max_body_size 16m;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
